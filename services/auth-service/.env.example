PORT=8084

JWT_PRIVATE_KEY=your-jwt-private-key-here
JWT_ISSUER=bnpb-auth-service
JWT_AUDIENCE=bnpb-client-api

ACCESS_TOKEN_TTL_SECONDS=60
REFRESH_TOKEN_TTL_SECONDS=3600

REDIS_ADDR=auth-store:6379

CLIENT_MEDIA_ID=media-client
CLIENT_MEDIA_SECRET=your-media-client-secret-here
CLIENT_MEDIA_SCOPE=hazards:read:summary

CLIENT_FIELD_ID=field-team
CLIENT_FIELD_SECRET=your-field-team-secret-here
CLIENT_FIELD_SCOPE=hazards:read:raw

CLIENT_OPS_ID=bnpb-ops
CLIENT_OPS_SECRET=your-bnpb-ops-secret-here
CLIENT_OPS_SCOPE=hazards:read:raw ops:admin
